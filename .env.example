# --- Database (PostgreSQL / Supabase) ---------------------------------------
# Local example: postgresql://postgres:<password>@localhost:5432/gbth?schema=public
# Supabase: use the pooled connection string for DATABASE_URL and the direct
# connection string for DIRECT_URL (used by Prisma migrations).
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth (admin only) ----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Not required for the MVP.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated list of e-mails allowed to access /admin (in addition to AdminUser rows).
ADMIN_EMAILS=

# --- Local development admin login (used only when Supabase is not configured) --
# Disabled automatically when NODE_ENV=production unless ALLOW_DEV_AUTH=true.
DEV_ADMIN_PASSWORD=
# Random string (>= 32 chars) used to sign the development session cookie.
DEV_AUTH_SECRET=
ALLOW_DEV_AUTH=false

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional analytics provider key (e.g. PostHog). Leave empty to log events locally.
NEXT_PUBLIC_ANALYTICS_PROVIDER=console
